#include "alioth-pinctrl.dtsi"
#include "xiaomi-sm8250-common.dtsi"
#include "alioth-audio-overlay.dtsi"

&firmware {
	android {
		compatible = "android,firmware";
		vbmeta {
			compatible = "android,vbmeta";
			[span_0](start_span)parts = "vbmeta,boot,system,vendor,dtbo";[span_0](end_span)
		};

		fstab {
			compatible = "android,fstab";
		};
	};
};
[span_1](start_span)/*IC int pin, rst pin init*/[span_1](end_span)
&tlmm {
        /* GPIO_24: FP_RESET_N */
        msm_gpio_24: msm_gpio_24 {
                mux {
                         pins = "gpio24";
			[span_2](start_span)function = "gpio";[span_2](end_span)
                };
                config {
                        pins = "gpio24";
			[span_3](start_span)drive-strength = <2>;[span_3](end_span)
                        bias-disable;
                        output-low;
                };
        };
        /* GPIO_24 : FP_RESET_N, state device active*/
        msm_gpio_24_output_high: msm_gpio_24_output_high {
                mux {
                        pins = "gpio24";
			[span_4](start_span)function = "gpio";[span_4](end_span)
                };
                config {
                        pins = "gpio24";
			[span_5](start_span)drive-strength = <2>;[span_5](end_span)
                        bias-disable;
                        output-high;
                };
        };
        /* GPIO_23 : FP_INT_N */
        msm_gpio_23: msm_gpio_23 {
                mux {
                        pins = "gpio23";
			[span_6](start_span)function = "gpio";[span_6](end_span)
                };
                config {
                        pins = "gpio23";
			[span_7](start_span)drive-strength = <2>;[span_7](end_span)
                        bias-pull-down;
                };
        };

};

&soc {

	testing_mode {
		compatible = "xiaomi,testing-mode";
		status-gpio = <&tlmm 70 0x00>;
		debounce-time = <30>;
		[span_8](start_span)pinctrl-names = "default";[span_8](end_span)
		pinctrl-0 = <&test_mode_irq>;
	};

};

&ts_active {
	mux {
		pins = "gpio33", "gpio39";
		function = "gpio";
	};
	[span_9](start_span)config {[span_9](end_span)
		pins = "gpio33", "gpio39";
		drive-strength = <8>;
		bias-pull-up;
	};
};

&ts_int_suspend {
	mux {
		pins = "gpio39";
		function = "gpio";
	};
	[span_10](start_span)config {[span_10](end_span)
		pins = "gpio39";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&ts_reset_suspend {
	mux {
		pins = "gpio33";
		function = "gpio";
	};
	[span_11](start_span)config {[span_11](end_span)
		pins = "gpio33";
		drive-strength = <2>;
		bias-pull-down;
	};
};

&pmx_ts_release {
	mux {
		pins = "gpio33", "gpio39";
		function = "gpio";
	};
	[span_12](start_span)config {[span_12](end_span)
		pins = "gpio33", "gpio39";
		drive-strength = <2>;
		bias-disable;
	};
};
&tlmm {
	ts_mux {
		ts_cs_active: ts_cs_active {
			mux {
				pins = "gpio11";
				[span_13](start_span)function = "qup4";[span_13](end_span)
			};

			config {
				pins = "gpio11";
				drive-strength = <16>;
				bias-pull-up;
			};
		};

		ts_cs_suspend: ts_cs_suspend {
			mux {
				pins = "gpio11";
				[span_14](start_span)function = "gpio";[span_14](end_span)
			};

			config {
				pins = "gpio11";
				drive-strength = <16>;
				bias-pull-up;
			};
		};
	};
};
[span_15](start_span)&qupv3_se4_spi_active {[span_15](end_span)
	mux {
		pins = "gpio8", "gpio9", "gpio10";
		function = "qup4";
	};

	config {
		pins = "gpio8", "gpio9", "gpio10";
		drive-strength = <6>;
		[span_16](start_span)bias-pull-down;[span_16](end_span)
	};
};

&qupv3_se4_spi_sleep {
	mux {
		pins = "gpio8", "gpio9", "gpio10";
		function = "gpio";
	};

	config {
		pins = "gpio8", "gpio9", "gpio10";
		[span_17](start_span)drive-strength = <6>;[span_17](end_span)
		bias-pull-down;
	};
};


&qupv3_se4_spi {
	status = "ok";
	pinctrl-0 = <&qupv3_se4_spi_active &ts_cs_active>;
	pinctrl-1 = <&qupv3_se4_spi_sleep &ts_cs_suspend>;
	[span_18](start_span)focaltech@0 {[span_18](end_span)
		status = "ok";
		compatible = "focaltech,fts";
		reg = <0x0>;
		spi-max-frequency = <10000000>;
		interrupt-parent = <&tlmm>;
		interrupts = <39 0x2008>;
		[span_19](start_span)pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";[span_19](end_span)
		pinctrl-0 = <&ts_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
		pinctrl-2 = <&pmx_ts_release>;
		vdd-supply = <&L10C>;
		[span_20](start_span)vcc_i2c-supply = <&L1C>;[span_20](end_span)
		focaltech,reset-gpio = <&tlmm 33 0x00>;
		focaltech,irq-gpio = <&tlmm 39 0x2008>;
		focaltech,max-touch-number = <10>;
		[span_21](start_span)focaltech,display-coords = <0 0 8640 19200>;[span_21](end_span)
		focaltech,open-min = <3000>;
		focaltech,touch-range-array = <1 5 10 15 20>;
		[span_22](start_span)focaltech,touch-def-array = <3 3 3 3>;[span_22](end_span)
		focaltech,touch-expert-array = <10 10 10 10
						20 20 15 10
						20 20 20 10>;
	};
};
[span_23](start_span)&qupv3_se15_i2c {[span_23](end_span)
	status = "ok";
	nq@64 {
		status = "disabled";
	};
};

&display_panel_avdd {
	status = "disabled";
};

&sde_dp {
	status = "disabled";
};
[span_24](start_span)&mdss_mdp {[span_24](end_span)
	connectors = <&sde_wb &sde_dsi &sde_dsi1 &sde_rscc>;
};

&dsi_sim_vid {
	qcom,panel-supply-entries = <&dsi_panel_pwr_supply_vci>;
	qcom,platform-reset-gpio = <&tlmm 12 0>;
};
[span_25](start_span)&pm8150a_amoled {[span_25](end_span)
	status = "disabled";
};

&usb1 {
        extcon = <&extcon_usb1>;
};
[span_26](start_span)&sde_dsi {[span_26](end_span)
	/delete-property/ vdd-supply;
	/delete-property/ avdd-supply;
	qcom,dsi-default-panel = <&dsi_sim_vid>;
	vci-supply = <&pm8150a_l11>;
};

&pm8150a_l11 {
	qcom,init-voltage = <3000000>;
	regulator-min-microvolt = <3000000>;
	[span_27](start_span)regulator-max-microvolt = <3000000>;[span_27](end_span)
};

&pm8150l_rgb_led {
	status = "disabled";
};

&soc {
	fingerprint_goodix {
		compatible = "goodix,fingerprint";
		goodix,gpio-reset = <&tlmm 24 GPIO_ACTIVE_LOW>;
		[span_28](start_span)goodix,gpio-irq = <&tlmm 23 GPIO_ACTIVE_HIGH>;[span_28](end_span)
		fp_vdd_vreg-supply = <&pm8150_l13>;
		status = "ok";
	};

	fingerprint_fpc {
		status = "ok";
		compatible = "fpc,fpc1020";
		[span_29](start_span)interrupt-parent = <&tlmm>;[span_29](end_span)
		interrupts = <23 0x0>;
		fpc,gpio_rst    = <&tlmm 24 0x0>;
		[span_30](start_span)fpc,gpio_irq    = <&tlmm 23 0x0>;[span_30](end_span)
		fp_vdd_vreg-supply = <&L13A>;
		pinctrl-names = "fpc1020_reset_reset",
			"fpc1020_reset_active",
			"fpc1020_irq_active";

		pinctrl-0 = <&msm_gpio_24>;
		pinctrl-1 = <&msm_gpio_24_output_high>;
		[span_31](start_span)pinctrl-2 = <&msm_gpio_23>;[span_31](end_span)

	};

/*
	fingerprint_3P0_VREG: fingerprint_3P0_VREG {
		compatible = "regulator-fixed";
		regulator-name = "fingerprint_3P0_VREG";
		startup-delay-us = <4000>;
		enable-active-high;
		[span_32](start_span)gpio = <&tlmm 10 0>;[span_32](end_span)
		regulator-always-on;
	};
*/
	xiaomi_touch {
		compatible = "xiaomi-touch";
		status = "ok";
		touch,name = "xiaomi-touch";
	};

};
[span_33](start_span)&L13A {[span_33](end_span)
	regulator-min-microvolt = <3304000>;
	regulator-max-microvolt = <3304000>;
	qcom,init-voltage = <3304000>;
	regulator-always-on;
};
[span_34](start_span)&tlmm {[span_34](end_span)
		/* FP_RESET_N */
	msm_gpio_reset: msm_gpio_reset {
		mux {
			pins = "gpio24";
			function = "gpio";
		};
		config {
			pins = "gpio24";
			drive-strength = <2>;
			[span_35](start_span)bias-disable;[span_35](end_span)
			output-low;
		};
	};
		/* FP_RESET_N, state device active*/
	msm_gpio_reset_output_high: msm_gpio_reset_output_high {
		mux {
			pins = "gpio24";
			function = "gpio";
		};
		[span_36](start_span)config {[span_36](end_span)
			pins = "gpio24";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};
		/* FP_INT_N */
	msm_gpio_irq: msm_gpio_irq {
		mux {
			pins = "gpio23";
			[span_37](start_span)function = "gpio";[span_37](end_span)
		};
		config {
			pins = "gpio23";
			drive-strength = <2>;
			bias-pull-down;
		};
	};
};

&qupv3_se15_i2c {
	#address-cells = <1>;
	[span_38](start_span)#size-cells = <0>;[span_38](end_span)
	status = "ok";
	bq25970-standalone@66 {
		compatible = "ti,bq2597x-standalone";
		reg = <0x66>;
		interrupt-parent = <&tlmm>;
		interrupts = <68 0x2002>;
		[span_39](start_span)pinctrl-names = "default";[span_39](end_span)
		pinctrl-0 = <&bq2597x_master_int_default>;

		/*ti,bq2597x,bat-ovp-disable;*/
		ti,bq2597x,bat-ovp-alarm-disable;
		ti,bq2597x,bat-ocp-disable;
		ti,bq2597x,bat-ocp-alarm-disable;
		ti,bq2597x,bat-ucp-alarm-disable;
		ti,bq2597x,bat-ucp-disable;

		/*ti,bq2597x,bus-ovp-alarm-disable;
		ti,bq2597x,bus-ocp-disable;
		ti,bq2597x,bus-ocp-alarm-disable;*/
		ti,bq2597x,bat-therm-disable;
		ti,bq2597x,bus-therm-disable;
		ti,bq2597x,die-therm-disable;

		ti,bq2597x,bat-ovp-threshold = <4525>;
		[span_40](start_span)ti,bq2597x,bat-ovp-alarm-threshold = <4525>;[span_40](end_span)
		//ti,bq2597x,bat-ocp-threshold = <8000>;
		//ti,bq2597x,bat-ocp-alarm-threshold = <7500>;

		ti,bq2597x,bus-ovp-threshold = <12000>;
		ti,bq2597x,bus-ovp-alarm-threshold = <11000>;
		ti,bq2597x,bus-ocp-threshold = <3750>;
		[span_41](start_span)ti,bq2597x,bus-ocp-alarm-threshold = <3500>;[span_41](end_span)

		//ti,bq2597x,bat-ucp-alarm-threshold = <2000>;

		ti,bq2597x,bat-therm-threshold = <0x15>;/*4.1%*/
		ti,bq2597x,bus-therm-threshold = <0x15>;/*4.1%*/
		ti,bq2597x,die-therm-threshold = <145>;

		ti,bq2597x,ac-ovp-threshold = <14>;
		//ti,bq2597x,sense-resistor-mohm = <2>;
	};
[span_42](start_span)};[span_42](end_span)

&qupv3_se16_i2c {
	status = "ok";
	ln8282@55 {
		compatible = "lionsemi,ln8282";
		status = "ok";
		reg = <0x55>;
		ln,enable = <&tlmm 156 0x00>;
		[span_43](start_span)ln,irq = <&tlmm 158 0x00>;[span_43](end_span)
		pinctrl-names = "ln8282_active","ln8282_suspend";
		pinctrl-0 = <&ln8282_enable_active>;
		pinctrl-1 = <&ln8282_enable_suspend>;
	};

	idtp9415: idtp9415@3b {
		compatible = "idt,p9415";
		[span_44](start_span)status = "ok";[span_44](end_span)
		reg = <0x3b>;
		idt,irq = <&tlmm 157 0x00>;
		idt,enable = <&tlmm 155 0x00>;
		[span_45](start_span)idt,reverse-enable = <&tlmm 154 0x00>;[span_45](end_span)
		idt,wpc-det = <&pm8150b_gpios 7 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default", "idt_active", "idt_suspend";
		pinctrl-0 = <&power_good_default>;
		[span_46](start_span)pinctrl-1 = <&idt_int_active &idt_enable_active &txon_enable_active>;[span_46](end_span)
		pinctrl-2 = <&idt_int_suspend &idt_enable_suspend &txon_enable_suspend>;
		mi,wireless-by-usbin;
		mi,only-idt-on-cmi;
	};

	rx1619@61 {
		compatible = "nuvolta,wl_charger_rx1619";
		reg = <0x61>;
		[span_47](start_span)status = "ok";[span_47](end_span)
		rx,irq_gpio = <&tlmm 157 0x00>;
		rx,tx_on_gpio = <&tlmm 154 0x00>;
		rx,power_good = <&pm8150b_gpios 7 GPIO_ACTIVE_HIGH>;
		[span_48](start_span)rx,enable = <&tlmm 155 0x00>;[span_48](end_span)
		pinctrl-names = "default","nu_active","nu_suspend";
		pinctrl-0 = <&power_good_default>;
		pinctrl-1 = <&nu_int_active &txon_enable_active &nu_sleep_active>;
		[span_49](start_span)pinctrl-2 = <&nu_int_suspend &txon_enable_suspend &nu_sleep_suspend>;[span_49](end_span)
		mi,wireless-by-usbin;
	};

	rx1619@67 {
		compatible = "nuvolta,wl_rx1619_trim";
		reg = <0x67>;
		status = "ok";
	};
};
