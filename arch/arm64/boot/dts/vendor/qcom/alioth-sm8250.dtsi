&thermal_zones {
	wireless_therm {//place close to wireless charge RX
		polling-delay-passive = <0>;
		polling-delay = <0>;
		[span_108](start_span)thermal-governor = "user_space";[span_108](end_span)
		thermal-sensors = <&pm8150b_adc_tm ADC_AMUX_THM1_PU2>;
		trips {
			active-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	[span_109](start_span)};[span_109](end_span)

	conn_therm {//place close to type-c connector
